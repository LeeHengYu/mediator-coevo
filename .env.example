# Local model calls made by the control plane use this value.
# Do not commit a real key here; copy this file to .env and fill it locally.
OPENROUTER_API_KEY=

# GCP VM used by `uv run medcoevo run --cloud` for remote SkillFlow Harbor jobs.
GCP_PROJECT_ID=agent-coevolution
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
GCP_VM_NAME=instance-a

# Remote scratch directory for prepared task workspaces and Harbor artifacts.
# The VM smoke path used a home-relative directory.
GCP_REMOTE_DIR=~/mediator-coevo

# Secret Manager version read by the VM service account at runtime.
# The secret value itself should stay in Secret Manager, not in this file.
GCP_OPENROUTER_SECRET=<secret-path>

# Informational for the direct VM path; the attached VM service account is used.
GCP_SERVICE_ACCOUNT=sa-used-on-vm@developer.gserviceaccount.com
