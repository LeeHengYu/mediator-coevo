            "content": "import zipfile\nimport json\nimport re\nfrom datetime import date\nfrom io import BytesIO\nimport xml.etree.ElementTree as ET\n\n\nTEMPLATE_PATH = 'clinic_intake_template.hwpx'\nPATIENT_PATH = 'patient_intake.json'\nOUTPUT_PATH = 'clinic_intake_ready.hwpx'\n\n\ndef local_name(tag: str) -> str:\n    \"\"\"Return the local name of an expanded XML tag '{uri}local'.\"\"\"\n    if tag.startswith('{'):\n        return tag.split('}', 1)[1]\n    return tag\n\n\ndef parse_xml_preserve_ns(xml_bytes: bytes) -> ET.Element:\n    \"\"\"Parse XML and register namespaces seen so ET keeps stable prefixes.\"\"\"\n    ns_map = {}\n    # start-ns yields (prefix, uri)\n    it = ET.iterparse(BytesIO(xml_bytes), events=('start-ns', 'start'))\n    root = None\n    for event, item in it:\n        if event == 'start-ns':\n            prefix, uri = item\n            # Keep first occurrence for each prefix.\n            if prefix in ns_map:\n                continue\n            ns_map[prefix] = uri\n        elif event == 'start' and root is None:\n            root = item\n\n    for prefix, uri in ns_map.items():\n        # xml.etree uses '' for default namespace.\n        ET.register_namespace(prefix if prefix is not None else '', uri)\n\n    if root is None:\n        raise ValueError('Failed to parse XML root')\n    return root\n\n\ndef korean_full_year_age(birth: date, visit: date) -> int:\n    age = visit.year - birth.year\n    if (visit.month, visit.day) < (birth.month, birth.day):\n        age -= 1\n    return age\n\n\ndef normalize_korean_mobile(phone: str) -> str:\n    digits = re.sub(r'\\D+', '', phone or '')\n    # Expected mobile: 010 + 8 digits.\n    if len(digits) == 11:\n        return f\"{digits[:3]}-{digits[3:7]}-{digits[7:]}\"\n    # Fallback: best-effort grouping.\n    if len(digits) == 10:\n        return f\"{digits[:3]}-{digits[3:6]}-{digits[6:]}\"\n    return phone\n\n\ndef build_placeholder_map(patient: dict) -> dict:\n    birth = date.fromisoformat(patient['생년월일'])\n    visit = date.fromisoformat(patient['방문일'])\n    age = korean_full_year_age(birth, visit)\n\n    values = dict(patient)\n    values['회신전화'] = normalize_korean_mobile(patient.get('회신전화', ''))\n    values['생년월일'] = f\"{patient['생년월일']} ({age}세)\"\n\n    # Map from literal placeholder token to replacement text.\n    return {f\"{{{{{k}}}}}\": str(v) for k, v in values.items()}\n\n\ndef find_placeholders_in_text(text: str) -> set[str]:\n    return set(re.findall(r'\\{\\{.*?\\}\\}', text))\n\n\ndef strip_layout_cache_from_paragraph(p_elem: ET.Element) -> int:\n    \"\"\"Remove layout-cache descendants (linesegarray, charShapeIds, etc.).\"\"\"\n    removed = 0\n\n    def should_remove(elem: ET.Element) -> bool:\n        name = local_name(elem.tag).lower()\n        return (\n            'lineseg' in name\n            or 'charshapeid' in name\n            or 'charshapeids' in name\n            or 'layout' in name\n        )\n\n    def recurse(parent: ET.Element) -> None:\n        nonlocal removed\n        for child in list(parent):\n            if should_remove(child):\n                parent.remove(child)\n                removed += 1\n            else:\n                recurse(child)\n\n    recurse(p_elem)\n    return removed\n\n\ndef paragraphs_with_placeholders(xml_bytes: bytes) -> set[str]:\n    root = parse_xml_preserve_ns(xml_bytes)\n    ids = set()\n    for elem in root.iter():\n        if local_name(elem.tag) != 'p':\n            continue\n        txt = ''.join(elem.itertext())\n        if '{{' in txt and '}}' in txt:\n            pid = elem.get('id')\n            if pid is not None:\n                ids.add(pid)\n    return ids\n\n\ndef main() -> None:\n    with open(PATIENT_PATH, 'r', encoding='utf-8') as f:\n        patient = json.load(f)\n\n    repl = build_placeholder_map(patient)\n\n    with zipfile.ZipFile(TEMPLATE_PATH, 'r') as zin:\n        infos = zin.infolist()\n        with zipfile.ZipFile(OUTPUT_PATH, 'w') as zout:\n            for info in infos:\n                data = zin.read(info.filename)\n\n                if info.filename.lower().endswith('.xml'):\n                    try:\n                        text = data.decode('utf-8')\n                    except UnicodeDecodeError:\n                        text = data.decode('utf-8', errors='ignore')\n\n                    if '{{' in text:\n                        # Identify paragraphs that originally contained placeholders.\n                        modified_para_ids = paragraphs_with_placeholders(data)\n\n                        # Replace all placeholders in raw text.\n                        new_text = text\n                        for token, value in repl.items():\n                            new_text = new_text.replace(token, value)\n\n                        # Validate that every placeholder token present is gone.\n                        leftover = find_placeholders_in_text(new_text)\n                        if leftover:\n                            raise RuntimeError(\n                                f\"Unreplaced placeholders remain in {info.filename}: {sorted(leftover)}\"\n                            )\n\n                        # Parse modified XML and strip layout cache for modified paragraphs.\n                        new_bytes = new_text.encode('utf-8')\n                        root = parse_xml_preserve_ns(new_bytes)\n\n                        removed_total = 0\n                        if modified_para_ids:\n                            for elem in root.iter():\n                                if local_name(elem.tag) != 'p':\n                                    continue\n                                if elem.get('id') in modified_para_ids:\n                                    removed_total += strip_layout_cache_from_paragraph(elem)\n\n                        out_bytes = ET.tostring(root, encoding='utf-8', xml_declaration=True)\n                        data = out_bytes\n\n                # Preserve original ZipInfo metadata as much as possible.\n                out_info = zipfile.ZipInfo(info.filename)\n                out_info.date_time = info.date_time\n                out_info.compress_type = info.compress_type\n                out_info.comment = info.comment\n                out_info.extra = info.extra\n                out_info.internal_attr = info.internal_attr\n                out_info.external_attr = info.external_attr\n                out_info.create_system = info.create_system\n                out_info.create_version = info.create_version\n                out_info.extract_version = info.extract_version\n                out_info.flag_bits = info.flag_bits\n\n                zout.writestr(out_info, data, compress_type=info.compress_type)\n\n\nif __name__ == '__main__':\n    main()\n"
