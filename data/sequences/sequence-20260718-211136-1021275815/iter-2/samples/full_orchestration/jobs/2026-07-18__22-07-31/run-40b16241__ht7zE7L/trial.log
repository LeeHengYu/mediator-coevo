2. **Create and run `/root/solve.py`** with the following logic:

```python
import csv, json, math

# Read ingredient_cost.csv
with open('"'"'/root/ingredient_cost.csv'"'"') as f:
    ingredient_rows = list(csv.DictReader(f))

# Read card_cost.csv
with open('"'"'/root/card_cost.csv'"'"') as f:
    card_rows = list(csv.DictReader(f))

# Read reimbursement.csv
with open('"'"'/root/reimbursement.csv'"'"') as f:
    reimb_rows = list(csv.DictReader(f))

# Build lookup dicts
card_cost_lookup = {}
for row in card_rows:
    card_cost_lookup[int(row['"'"'blister_card_count'"'"'])] = float(row['"'"'card_cost_usd'"'"'])

reimb_lookup = {}
for row in reimb_rows:
    reimb_lookup[row['"'"'medication'"'"'].strip()] = float(row['"'"'reimbursement_per_cycle_180_patients_usd'"'"'])

# Constants
patients = 180
fills_28 = 12
fills_56 = 6
caps_per_fill_28 = 56
caps_per_fill_56 = 112
threshold = 9000

medications = []
for row in ingredient_rows:
    med = row['"'"'medication'"'"'].strip()
    price_per_1000 = float(row['"'"'price_per_1000_capsules_usd'"'"'])
    blister_card_count = int(row['"'"'blister_card_count'"'"'])
    card_cost = card_cost_lookup[blister_card_count]
    reimb_per_cycle = reimb_lookup[med]

    # Drug cost: (capsules_per_fill * fills * patients) / 1000 * price_per_1000
    annual_drug_cost_28 = round((caps_per_fill_28 * fills_28 * patients) / 1000.0 * price_per_1000, 2)
    annual_drug_cost_56 = round((caps_per_fill_56 * fills_56 * patients) / 1000.0 * price_per_1000, 2)

    # Packaging cost: card_cost * patients * fills
    annual_pkg_28 = round(card_cost * patients * fills_28, 2)
    annual_pkg_56 = round(card_cost * patients * fills_56, 2)

    # Reimbursement: reimb_per_cycle * fills
    annual_reimb_28 = round(reimb_per_cycle * fills_28, 2)
    annual_reimb_56 = round(reimb_per_cycle * fills_56, 2)

    # Margin
    margin_28 = round(annual_reimb_28 - annual_drug_cost_28 - annual_pkg_28, 2)
    margin_56 = round(annual_reimb_56 - annual_drug_cost_56 - annual_pkg_56, 2)
    diff = round(margin_56 - margin_28, 2)

    medications.append({
        '"'"'medication'"'"': med,
        '"'"'price_per_1000_capsules_usd'"'"': price_per_1000,
        '"'"'blister_card_count'"'"': blister_card_count,
        '"'"'card_cost_usd'"'"': card_cost,
        '"'"'reimbursement_per_cycle_180_patients_usd'"'"': reimb_per_cycle,
        '"'"'annual_drug_cost_28_day_usd'"'"': annual_drug_cost_28,
        '"'"'annual_drug_cost_56_day_usd'"'"': annual_drug_cost_56,
        '"'"'annual_packaging_cost_28_day_usd'"'"': annual_pkg_28,
        '"'"'annual_packaging_cost_56_day_usd'"'"': annual_pkg_56,
        '"'"'annual_reimbursement_28_day_usd'"'"': annual_reimb_28,
        '"'"'annual_reimbursement_56_day_usd'"'"': annual_reimb_56,
        '"'"'annual_margin_28_day_usd'"'"': margin_28,
        '"'"'annual_margin_56_day_usd'"'"': margin_56,
        '"'"'annual_margin_difference_56_minus_28_usd'"'"': diff
    })

# Sort alphabetically by medication
medications.sort(key=lambda x: x['"'"'medication'"'"'])

# Totals
total_margin_28 = round(sum(m['"'"'annual_margin_28_day_usd'"'"'] for m in medications), 2)
total_margin_56 = round(sum(m['"'"'annual_margin_56_day_usd'"'"'] for m in medications), 2)
total_diff = round(total_margin_56 - total_margin_28, 2)
abs_diff = round(abs(total_diff), 2)

# Decision
if abs_diff < 9000:
    decision = '"'"'convert_to_56_day'"'"'
    justification = f'"'"'The absolute total margin difference of ${abs_diff} is below the ${threshold} threshold, so converting to 56-day cycles is recommended.'"'"'
else:
    decision = '"'"'keep_28_day'"'"'
    justification = f'"'"'The absolute total margin difference of ${abs_diff} exceeds the ${threshold} threshold, so keeping 28-day cycles is recommended.'"'"'

result = {
    '"'"'assumptions'"'"': {
        '"'"'patients_per_medication'"'"': patients,
        '"'"'fills_per_year_28_day'"'"': fills_28,
        '"'"'fills_per_year_56_day'"'"': fills_56,
        '"'"'capsules_per_fill_28_day'"'"': caps_per_fill_28,
        '"'"'capsules_per_fill_56_day'"'"': caps_per_fill_56,
        '"'"'switch_threshold_usd'"'"': threshold
    },
    '"'"'medications'"'"': medications,
    '"'"'totals'"'"': {
        '"'"'total_annual_margin_28_day_usd'"'"': total_margin_28,
        '"'"'total_annual_margin_56_day_usd'"'"': total_margin_56,
        '"'"'total_annual_margin_difference_56_minus_28_usd'"'"': total_diff,
        '"'"'absolute_total_margin_difference_usd'"'"': abs_diff
    },
    '"'"'recommendation'"'"': {
        '"'"'decision'"'"': decision,
        '"'"'justification'"'"': justification
    }
}

with open('"'"'/root/syncpack_analysis.json'"'"', '"'"'w'"'"') as f:
    json.dump(result, f, indent=2)

# Write summary
lines = [
    '"'"'# Syncpack Analysis Summary'"'"',
    f'"'"'Total 28-day annual margin: ${total_margin_28}'"'"',
    f'"'"'Total 56-day annual margin: ${total_margin_56}'"'"',
    f'"'"'Absolute margin difference: ${abs_diff}'"'"',
    f'"'"'Recommendation: {decision}'"'"',
]
with open('"'"'/root/syncpack_summary.md'"'"', '"'"'w'"'"') as f:
    f.write('"'"'\n'"'"'.join(lines) + '"'"'\n'"'"')

print('"'"'Done.'"'"')
print(json.dumps(result, indent=2))
```

3. **Run the script:**
```bash
python3 /root/solve.py
```

4. **Validate the outputs:**
```bash
python3 -c "
import json
with open('"'"'/root/syncpack_analysis.json'"'"') as f:
    d = json.load(f)
assert '"'"'assumptions'"'"' in d
assert '"'"'medications'"'"' in d
assert '"'"'totals'"'"' in d
assert '"'"'recommendation'"'"' in d
assert d['"'"'recommendation'"'"']['"'"'decision'"'"'] in ('"'"'convert_to_56_day'"'"', '"'"'keep_28_day'"'"')
assert len(d['"'"'medications'"'"']) > 0
# Check sorted
meds = [m['"'"'medication'"'"'] for m in d['"'"'medications'"'"']]
assert meds == sorted(meds), f'"'"'Not sorted: {meds}'"'"'
# Check all required keys in each medication
req_keys = ['"'"'medication'"'"','"'"'price_per_1000_capsules_usd'"'"','"'"'blister_card_count'"'"','"'"'card_cost_usd'"'"','"'"'reimbursement_per_cycle_180_patients_usd'"'"','"'"'annual_drug_cost_28_day_usd'"'"','"'"'annual_drug_cost_56_day_usd'"'"','"'"'annual_packaging_cost_28_day_usd'"'"','"'"'annual_packaging_cost_56_day_usd'"'"','"'"'annual_reimbursement_28_day_usd'"'"','"'"'annual_reimbursement_56_day_usd'"'"','"'"'annual_margin_28_day_usd'"'"','"'"'annual_margin_56_day_usd'"'"','"'"'annual_margin_difference_56_minus_28_usd'"'"']
for m in d['"'"'medications'"'"']:
    for k in req_keys:
        assert k in m, f'"'"'Missing key {k} in {m[\"medication\"]}'"'"'
print('"'"'JSON schema OK'"'"')

with open('"'"'/root/syncpack_summary.md'"'"') as f:
    lines = [l for l in f.read().strip().split('"'"'\\n'"'"') if l.strip()]
assert 4 <= len(lines) <= 8, f'"'"'Summary has {len(lines)} non-empty lines'"'"'
print('"'"'Summary OK'"'"')
print('"'"'All validations passed.'"'"')
"
```

