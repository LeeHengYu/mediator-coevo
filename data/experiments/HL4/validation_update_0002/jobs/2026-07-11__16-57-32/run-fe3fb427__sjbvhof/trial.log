## 2. Parse the update data
Write a Python script `/tmp/hwpx_work/update.py` that does all the work:

```python
import json, csv, os, re, shutil, copy
from lxml import etree

# --- Load update data ---
with open('"'"'/root/renewal_update.json'"'"', '"'"'r'"'"', encoding='"'"'utf-8'"'"') as f:
    updates = json.load(f)

with open('"'"'/root/followups.csv'"'"', '"'"'r'"'"', encoding='"'"'utf-8'"'"') as f:
    reader = csv.DictReader(f)
    followups = sorted(list(reader), key=lambda r: int(r['"'"'sequence'"'"']))

print('"'"'Updates:'"'"', json.dumps(updates, ensure_ascii=False, indent=2))
print('"'"'Follow-ups:'"'"', followups)

# --- Locate section XML(s) ---
base = '"'"'/tmp/hwpx_work/original'"'"'
section_files = []
for root_dir, dirs, files in os.walk(base):
    for fn in files:
        if fn.endswith('"'"'.xml'"'"'):
            full = os.path.join(root_dir, fn)
            with open(full, '"'"'r'"'"', encoding='"'"'utf-8'"'"') as xf:
                content = xf.read()
            # Section files typically have <hp:p> paragraph elements
            if '"'"'<hp:p'"'"' in content or '"'"'<p '"'"' in content:
                section_files.append(full)

print('"'"'Section files:'"'"', section_files)

# --- Helper: get plain text of a paragraph (concatenate all charPr text runs) ---
def para_plain_text(p_elem, ns):
    """Return the concatenated plain text of all <hp:t> elements in a paragraph."""
    texts = []
    for t in p_elem.iter('"'"'{%s}t'"'"' % ns.get('"'"'hp'"'"', ns.get('"'"'hc'"'"', '"'"''"'"'))):
        if t.text:
            texts.append(t.text)
    # Also try without namespace
    for t in p_elem.iter('"'"'t'"'"'):
        if t.text:
            texts.append(t.text)
    return '"'"''"'"'.join(texts)

# --- Helper: merge split placeholder tags ---
def merge_split_placeholders(xml_string):
    """If a placeholder like {{...}} is split across multiple <hp:t> tags,
    merge them so we can do simple text replacement."""
    # Pattern: find {{ that doesn'"'"'t close on the same <hp:t>, merge forward
    # Strategy: work on raw XML string, find sequences where '"'"'{{'"'"' and '"'"'}}'"'"' are
    # in different <hp:t> elements and merge the text content.
    # Simpler approach: strip internal XML tags between {{ and }}
    result = xml_string
    # Repeatedly merge: find '"'"'{{'"'"' not followed by '"'"'}}'"'"' before next '"'"'</hp:t>'"'"'
    pattern = r'"'"'(\{\{[^}]*?)(</hp:t>.*?<hp:t[^>]*>)([^{]*?\}\})'"'"'
    max_iter = 50
    for _ in range(max_iter):
        new_result = re.sub(pattern, r'"'"'\1\3'"'"', result, flags=re.DOTALL)
        if new_result == result:
            break
        result = new_result
    return result

# --- Process each section file ---
for section_file in section_files:
    print(f'"'"'\nProcessing: {section_file}'"'"')
    with open(section_file, '"'"'r'"'"', encoding='"'"'utf-8'"'"') as f:
        raw_xml = f.read()

    # Detect the namespace for hp
    # Extract namespace map from root
    tree = etree.parse(section_file)
    root = tree.getroot()
    nsmap = root.nsmap
    print('"'"'Namespaces:'"'"', nsmap)

    hp_ns = nsmap.get('"'"'hp'"'"', nsmap.get('"'"'hc'"'"', '"'"''"'"'))
    
    # We'"'"'ll work on raw XML text for replacements, then parse again to clean up layout cache.
    
    # Step A: Merge any split placeholders (just in case)
    raw_xml = merge_split_placeholders(raw_xml)
    
    # Step B: Build old->new replacement map from update JSON
    # The JSON likely has keys like "customer_name", "current_owner", etc.
    # with sub-keys "old" and "new" or it might be flat.
    # Inspect structure first:
    replacements = {}  # old_text -> new_text
    
    if isinstance(updates, dict):
        for key, val in updates.items():
            if isinstance(val, dict) and '"'"'old'"'"' in val and '"'"'new'"'"' in val:
                replacements[str(val['"'"'old'"'"'])] = str(val['"'"'new'"'"'])
            elif isinstance(val, dict):
                # Maybe nested differently
                for subkey, subval in val.items():
                    if isinstance(subval, dict) and '"'"'old'"'"' in subval and '"'"'new'"'"' in subval:
                        replacements[str(subval['"'"'old'"'"'])] = str(subval['"'"'new'"'"'])
            # If it'"'"'s just a simple value, we might need context from the document
    
    print('"'"'Replacement map:'"'"', json.dumps(replacements, ensure_ascii=False, indent=2))
    
    # If the JSON is flat key->value (no old/new), we need to find old values in the doc.
    # Let'"'"'s handle that case too:
    if not replacements:
        # Flat structure: keys are field names, values are new values
        # We need to find old values in the document by field name context
        # This requires more sophisticated matching
        print('"'"'WARNING: No old/new pairs found. JSON might be flat or differently structured.'"'"')
        print('"'"'Will attempt direct field-value replacement strategy.'"'"')
        # We'"'"'ll handle this after seeing the actual JSON structure
    
    # Step C: Apply text replacements
    for old_text, new_text in replacements.items():
        count = raw_xml.count(old_text)
        print(f'"'"'  Replacing "{old_text}" -> "{new_text}" ({count} occurrences)'"'"')
        raw_xml = raw_xml.replace(old_text, new_text)
    
    # Step D: Handle follow-up lines
    # Parse the XML to find follow-up paragraphs and replace them
    # First, let'"'"'s identify follow-up lines in the document
    # They likely contain numbered items or specific markers
    
    # Parse modified XML
    tree = etree.fromstring(raw_xml.encode('"'"'utf-8'"'"'))
    
    # Find all paragraphs
    all_paras = tree.iter('"'"'{%s}p'"'"' % hp_ns) if hp_ns else tree.iter('"'"'p'"'"')
    all_paras = list(tree.iter('"'"'{%s}p'"'"' % hp_ns)) if hp_ns else list(tree.iter('"'"'p'"'"'))
    
    # Identify the three follow-up paragraphs
    # They might contain text like "1차", "2차", "3차" or "follow-up" or numbered items
    followup_paras = []
    followup_indices = []
    appendix_text = '"'"'이 부록 문단은 그대로 유지해야 합니다.'"'"'
    
    for i, p in enumerate(all_paras):
        texts = []
        for t_elem in p.iter('"'"'{%s}t'"'"' % hp_ns):
            if t_elem.text:
                texts.append(t_elem.text)
        full_text = '"'"''"'"'.join(texts)
        # Skip appendix
        if appendix_text in full_text:
            continue
        # Detect follow-up lines (heuristic: contains 차 follow-up, or D+number pattern)
        if re.search(r'"'"'(\d차|D\+\d|follow.?up|팔로우|후속)'"'"', full_text, re.IGNORECASE):
            followup_paras.append((i, p, full_text))
            print(f'"'"'  Follow-up candidate [{i}]: {full_text[:80]}'"'"')
    
    print(f'"'"'  Found {len(followup_paras)} follow-up paragraphs, need to replace with {len(followups)} items'"'"')
    
    # For each follow-up paragraph, replace its text content with the CSV item
    # Match by position (first 3 follow-up paragraphs -> 3 CSV items sorted by sequence)
    for idx, (para_idx, para_elem, old_text_content) in enumerate(followup_paras[:len(followups)]):
        fu = followups[idx]
        # Build new follow-up text from CSV columns
        # CSV likely has columns like: sequence, day, channel, action or similar
        csv_keys = list(fu.keys())
        print(f'"'"'  CSV keys: {csv_keys}'"'"')
        # Construct replacement text - use all non-sequence fields or a specific format
        # We need to see the CSV structure to decide
        new_fu_parts = []
        for k in csv_keys:
            if k.lower() != '"'"'sequence'"'"':
                new_fu_parts.append(fu[k])
        new_fu_text = '"'"' / '"'"'.join(new_fu_parts) if len(new_fu_parts) > 1 else new_fu_parts[0] if new_fu_parts else str(fu)
        
        # Actually, let'"'"'s look at the original text format and replicate it
        # For now, construct from CSV values
        # Better: use all CSV fields except sequence, joined appropriately
        # Let'"'"'s try: "label: action" or just concatenate meaningfully
        
        # Replace all <hp:t> text in this paragraph with the new text
        t_elems = list(para_elem.iter('"'"'{%s}t'"'"' % hp_ns))
        if t_elems:
            t_elems[0].text = new_fu_text
            for t_extra in t_elems[1:]:
                t_extra.text = '"'"''"'"'
        print(f'"'"'  Replaced follow-up {idx+1}: "{old_text_content[:60]}" -> "{new_fu_text}"'"'"')
    
    # If there are more old follow-up paragraphs than new ones, remove extras
    for idx in range(len(followups), len(followup_paras)):
        para_idx, para_elem, old_text_content = followup_paras[idx]
        parent = para_elem.getparent()
        if parent is not None:
            parent.remove(para_elem)
            print(f'"'"'  Removed extra follow-up paragraph: "{old_text_content[:60]}"'"'"')
    
    # Step E: Remove lineSegArray (layout cache) from any modified paragraphs
    # To be safe, remove ALL lineSegArray elements since this is a content update
    for lsa in tree.iter('"'"'{%s}lineSegArray'"'"' % hp_ns):
        parent = lsa.getparent()
        if parent is not None:
            parent.remove(lsa)
    # Also try with other possible namespace prefixes
    for ns_uri in nsmap.values():
        if ns_uri:
            for lsa in tree.iter('"'"'{%s}lineSegArray'"'"' % ns_uri):
                parent = lsa.getparent()
                if parent is not None:
                    parent.remove(lsa)
    
    # Step F: Verify appendix is preserved
    found_appendix = False
    for t_elem in tree.iter('"'"'{%s}t'"'"' % hp_ns):
        if t_elem.text and appendix_text in t_elem.text:
            found_appendix = True
            break
    print(f'"'"'  Appendix preserved: {found_appendix}'"'"')
    
    # Step G: Write back
    final_xml = etree.tostring(tree, xml_declaration=True, encoding='"'"'UTF-8'"'"', pretty_print=False)
    with open(section_file, '"'"'wb'"'"') as f:
        f.write(final_xml)
    print(f'"'"'  Written: {section_file}'"'"')

# --- Repack the HWPX ---
output_path = '"'"'/root/renewal_playbook_updated.hwpx'"'"'
os.chdir('"'"'/tmp/hwpx_work/original'"'"')

