```python
import json, csv

# Load therapy catalog
with open('"'"'/root/therapy_catalog.json'"'"') as f:
    catalog = json.load(f)

# Filter to in-scope therapies (include_in_review == true)
in_scope = {t['"'"'therapy_code'"'"']: t for t in catalog['"'"'therapies'"'"'] if t.get('"'"'include_in_review'"'"') is True}

# Build a lookup: therapy_name or alias -> therapy_code
name_to_code = {}
for code, t in in_scope.items():
    name_to_code[t['"'"'therapy_name'"'"'].strip().lower()] = code
    for alias in t.get('"'"'aliases'"'"', []):
        name_to_code[alias.strip().lower()] = code

# Load bag supply cost: bag_size_ml -> bag_supply_cost_usd
bag_costs = {}
with open('"'"'/root/bag_supply_cost.csv'"'"') as f:
    reader = csv.DictReader(f)
    for row in reader:
        bag_costs[int(row['"'"'bag_size_ml'"'"'])] = float(row['"'"'bag_supply_cost_usd'"'"'])

# Load delivery payment: map therapy_label -> payment, only for in-scope
payments = {}  # therapy_code -> payment_per_delivery_per_patient_usd
with open('"'"'/root/delivery_payment.csv'"'"') as f:
    reader = csv.DictReader(f)
    for row in reader:
        label = row['"'"'therapy_label'"'"'].strip().lower()
        if label in name_to_code:
            code = name_to_code[label]
            payments[code] = float(row['"'"'payment_per_delivery_per_patient_usd'"'"'])

# Load patient overrides: for each in-scope therapy_code, keep approved row with highest revision
patient_counts = {}  # therapy_code -> active_patients
patient_revisions = {}  # therapy_code -> highest revision seen
with open('"'"'/root/patient_overrides.csv'"'"') as f:
    reader = csv.DictReader(f)
    for row in reader:
        if row['"'"'status'"'"'].strip().lower() != '"'"'approved'"'"':
            continue
        code = row['"'"'therapy_code'"'"'].strip()
        if code not in in_scope:
            continue
        rev = int(row['"'"'revision'"'"'])
        if code not in patient_revisions or rev > patient_revisions[code]:
            patient_revisions[code] = rev
            patient_counts[code] = int(row['"'"'active_patients'"'"'])

# Constants
del_7 = 52
del_14 = 26
days_7 = 7
days_14 = 14

# Build therapy results sorted by therapy_code ascending
therapy_codes_sorted = sorted(in_scope.keys())
therapies_out = []
total_margin_7 = 0.0
total_margin_14 = 0.0

for code in therapy_codes_sorted:
    t = in_scope[code]
    active = patient_counts.get(code, 0)
    drug_cost_per_1000 = float(t['"'"'drug_cost_per_1000_mg_usd'"'"'])
    dose_mg = float(t['"'"'dose_mg_per_day'"'"'])
    bag_ml = int(t['"'"'bag_size_ml'"'"'])
    bag_cost = bag_costs.get(bag_ml, 0.0)
    payment = payments.get(code, 0.0)

    # Annual drug cost
    adc_7 = drug_cost_per_1000 * active * dose_mg * days_7 * del_7 / 1000
    adc_14 = drug_cost_per_1000 * active * dose_mg * days_14 * del_14 / 1000

    # Annual supply cost: bag_supply_cost_usd * active_patients * deliveries_per_year
    asc_7 = bag_cost * active * del_7
    asc_14 = bag_cost * active * del_14

    # Annual revenue
    rev_7 = payment * active * del_7
    rev_14 = payment * active * del_14

    # Annual margin
    margin_7 = rev_7 - adc_7 - asc_7
    margin_14 = rev_14 - adc_14 - asc_14
    diff = margin_14 - margin_7

    total_margin_7 += margin_7
    total_margin_14 += margin_14

    therapies_out.append({
        "therapy_code": code,
        "therapy_name": t['"'"'therapy_name'"'"'],
        "active_patients": active,
        "drug_cost_per_1000_mg_usd": round(drug_cost_per_1000, 2),
        "dose_mg_per_day": round(dose_mg, 2),
        "bag_size_ml": bag_ml,
        "bag_supply_cost_usd": round(bag_cost, 2),
        "payment_per_delivery_per_patient_usd": round(payment, 2),
        "annual_drug_cost_7_day_usd": round(adc_7, 2),
        "annual_drug_cost_14_day_usd": round(adc_14, 2),
        "annual_supply_cost_7_day_usd": round(asc_7, 2),
        "annual_supply_cost_14_day_usd": round(asc_14, 2),
        "annual_revenue_7_day_usd": round(rev_7, 2),
        "annual_revenue_14_day_usd": round(rev_14, 2),
        "annual_margin_7_day_usd": round(margin_7, 2),
        "annual_margin_14_day_usd": round(margin_14, 2),
        "annual_margin_difference_14_minus_7_usd": round(diff, 2)
    })

total_diff = round(total_margin_14 - total_margin_7, 2)
abs_diff = round(abs(total_diff), 2)

if abs_diff < 15000:
    decision = "move_to_14_day"
    justification = f"Absolute margin difference ${abs_diff:,.2f} is below the $15,000 threshold, so switching to 14-day delivery is recommended."
else:
    decision = "keep_7_day"
    justification = f"Absolute margin difference ${abs_diff:,.2f} exceeds the $15,000 threshold, so keeping 7-day delivery is recommended."

output = {
    "assumptions": {
        "deliveries_per_year_7_day": 52,
        "deliveries_per_year_14_day": 26,
        "days_per_delivery_7_day": 7,
        "days_per_delivery_14_day": 14,
        "switch_threshold_usd": 15000,
        "patient_override_rule": "highest approved revision per therapy_code"
    },
    "therapies": therapies_out,
    "totals": {
        "total_annual_margin_7_day_usd": round(total_margin_7, 2),
        "total_annual_margin_14_day_usd": round(total_margin_14, 2),
        "total_annual_margin_difference_14_minus_7_usd": total_diff,
        "absolute_total_margin_difference_usd": abs_diff
    },
    "recommendation": {
        "decision": decision,
        "justification": justification
    }
}

with open('"'"'/root/infusion_batch_analysis.json'"'"', '"'"'w'"'"') as f:
    json.dump(output, f, indent=2)

# Write markdown summary with comma-formatted currency values
lines = [
    "# Infusion Batch Analysis Summary",
    "",
    f"- Total 7-day margin: ${round(total_margin_7, 2):,.2f}",
    f"- Total 14-day margin: ${round(total_margin_14, 2):,.2f}",
    f"- Absolute difference: ${abs_diff:,.2f}",
    f"- Decision: {decision}",
    "",
    f"{justification}"
]

with open('"'"'/root/infusion_batch_summary.md'"'"', '"'"'w'"'"') as f:
    f.write('"'"'\n'"'"'.join(lines) + '"'"'\n'"'"')

print("Done.")
```

3. **Run the script**: `python /root/solve.py`

4. **Validate outputs**:
   - `cat /root/infusion_batch_analysis.json` — verify the `assumptions` block has exactly these keys: `deliveries_per_year_7_day`, `deliveries_per_year_14_day`, `days_per_delivery_7_day`, `days_per_delivery_14_day`, `switch_threshold_usd`, `patient_override_rule`. No extra keys like `currency` or `decision_threshold_usd`.
   - `cat /root/infusion_batch_summary.md` — verify margin values use comma-separated thousands formatting (e.g., `-455,619.31` not `-455619.31`), that the file has 4-8 non-empty lines, and that the decision slug (`move_to_14_day` or `keep_7_day`) appears verbatim.
   - Verify `therapies` array is sorted by `therapy_code` ascending.

5. **Run the verifier if present**: `cd /root && python -m pytest test_output.py -v` (or whatever test file exists). If tests fail, read the error messages, fix `solve.py`, and re-run until all tests pass.

Key points from prior feedback to avoid:
- The `assumptions` block MUST use the exact keys from the schema: `switch_threshold_usd` (not `decision_threshold_usd`) and `patient_override_rule` (not omitted). Do NOT add extra keys like `currency`.
- The markdown summary MUST format currency with commas as thousands separators using `f'"'"'{value:,.2f}'"'"'`.
- Annual supply cost formula: `bag_supply_cost_usd * active_patients * deliveries_per_year` (one bag per delivery per patient).

