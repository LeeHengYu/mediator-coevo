```
Note every key-value pair. Pay special attention to Korean text values — they must be inserted exactly as-is.

### 3. Explore the HWPX template structure
```bash
mkdir -p /tmp/hwpx_work
cp inventory_report_template.hwpx /tmp/hwpx_work/template.zip
cd /tmp/hwpx_work
unzip -o template.zip -d template_contents
find template_contents -type f | sort
```

### 4. Identify all section XML files and locate placeholders
```bash
for f in $(find template_contents -name '"'"'*.xml'"'"'); do
  echo "=== $f ==="
  cat "$f"
  echo
done
```
Search for `{{` patterns. **Critical**: Placeholders may be split across multiple `<hp:t>` elements within the same `<hp:run>` or across adjacent runs. For example, `{{item_name}}` might appear as `<hp:t>{{ite</hp:t>` in one run and `<hp:t>m_name}}</hp:t>` in the next.

### 5. Write a Python script to perform the replacement
Create `/tmp/hwpx_work/fill_template.py` with the following approach:

```python
import json
import os
import re
import shutil
import zipfile

# Paths
JSON_PATH = '"'"'/root/inventory_data.json'"'"'
TEMPLATE_PATH = '"'"'/root/inventory_report_template.hwpx'"'"'
OUTPUT_PATH = '"'"'/root/inventory_report_ready.hwpx'"'"'
WORK_DIR = '"'"'/tmp/hwpx_fill'"'"'

# Load JSON data
with open(JSON_PATH, '"'"'r'"'"', encoding='"'"'utf-8'"'"') as f:
    data = json.load(f)

# Build flat replacement map: handle nested dicts/lists if present
def flatten(obj, prefix='"'"''"'"'):
    items = {}
    if isinstance(obj, dict):
        for k, v in obj.items():
            new_key = f"{prefix}{k}" if not prefix else f"{prefix}.{k}"
            if isinstance(v, (dict, list)):
                items.update(flatten(v, new_key))
            else:
                items[new_key] = str(v)
    elif isinstance(obj, list):
        for i, v in enumerate(obj):
            new_key = f"{prefix}[{i}]"
            if isinstance(v, (dict, list)):
                items.update(flatten(v, new_key))
            else:
                items[new_key] = str(v)
    return items

# Try flat keys first (top-level), then dotted
replacements = {}
if isinstance(data, dict):
    for k, v in data.items():
        if isinstance(v, (dict, list)):
            replacements.update(flatten(v, k))
        else:
            replacements[k] = str(v)

print("Replacement map:")
for k, v in replacements.items():
    print(f"  {k} -> {v}")

# Extract HWPX
if os.path.exists(WORK_DIR):
    shutil.rmtree(WORK_DIR)
os.makedirs(WORK_DIR)

with zipfile.ZipFile(TEMPLATE_PATH, '"'"'r'"'"') as zf:
    zf.extractall(WORK_DIR)

# Process each XML file
for root_dir, dirs, files in os.walk(WORK_DIR):
    for fname in files:
        if not fname.endswith('"'"'.xml'"'"'):
            continue
        fpath = os.path.join(root_dir, fname)
        with open(fpath, '"'"'r'"'"', encoding='"'"'utf-8'"'"') as f:
            content = f.read()
        
        if '"'"'{{'"'"' not in content:
            continue
        
        print(f"\nProcessing: {fpath}")
        original = content
        
        # Strategy: First, merge split placeholders across <hp:t> tags.
        # Pattern: find sequences of <hp:t>...partial placeholder...</hp:t>
        # that together form a {{key}} pattern.
        
        # Step A: Concatenate all <hp:t> content within each <hp:run> to detect
        # split placeholders, then rebuild runs with merged text.
        
        # More robust approach: work at the full-text level.
        # Extract all text between <hp:t> and </hp:t>, join them, find placeholders,
        # then do targeted replacement.
        
        # Approach: iteratively merge adjacent <hp:t> elements that together
        # contain a partial placeholder pattern.
        
        # Simple but effective: collapse </hp:t>...<hp:t> sequences within runs
        # when they split a placeholder. We do this by:
        # 1. Finding all </hp:t>...</hp:t> sequences where removing the middle
        #    tags would complete a {{...}} pattern.
        
        # Most reliable approach: use regex to merge hp:t tags that split placeholders
        import xml.etree.ElementTree as ET
        
        # Simpler text-level approach that handles split tags:
        # Remove tags between split placeholder parts, then re-add structure
        
        # Actually, the most reliable method for HWPX:
        # 1. Find all {{...}} patterns even if split across tags
        # 2. Merge the text nodes
        
        # Use a regex that matches across XML tags within hp:t elements
        def merge_and_replace(xml_text):
            # First, try simple replacement for non-split placeholders
            for key, val in replacements.items():
                placeholder = '"'"'{{'"'"' + key + '"'"'}}'"'"'
                xml_text = xml_text.replace(placeholder, val)
            
            # Check if any {{ remain - if so, they'"'"'re split across tags
            if '"'"'{{'"'"' not in xml_text:
                return xml_text
            
            # Handle split placeholders: collapse </hp:t>*<hp:t> between {{ and }}
            # Pattern: find {{ in one hp:t and }} in a later hp:t with only
            # </hp:t>, </hp:run>, <hp:run ...>, <hp:t> type tags between them
            
            # Aggressive but safe: merge text across adjacent hp:t boundaries
            # by removing intermediate close/open tags
            tag_between = re.compile(
                r'"'"'(\{\{[^}]*?)'"'"'
                r'"'"'(</hp:t>\s*(?:</hp:run>\s*<hp:run[^>]*>\s*)?(?:<hp:rPr[^>]*/>\s*)?<hp:t>)'"'"'
                r'"'"'([^<]*?)'"'"'
            )
            
            max_iterations = 50
            for _ in range(max_iterations):
                new_text = tag_between.sub(r'"'"'\1\3'"'"', xml_text)
                if new_text == xml_text:
                    break
                xml_text = new_text
            
            # Now try replacements again
            for key, val in replacements.items():
                placeholder = '"'"'{{'"'"' + key + '"'"'}}'"'"'
                xml_text = xml_text.replace(placeholder, val)
            
            # If still remaining, try even more aggressive merging
            if '"'"'{{'"'"' in xml_text:
                # Try merging across any intervening XML tags
                tag_between2 = re.compile(
                    r'"'"'(\{\{[^}<]*?)'"'"'
                    r'"'"'(<[^>]+>)'"'"'
                    r'"'"'([^<]*?)'"'"'
                )
                for _ in range(100):
                    new_text = tag_between2.sub(r'"'"'\1\3'"'"', xml_text)
                    if new_text == xml_text:
                        break
                    xml_text = new_text
                    # Try replacement after each merge
                    for key, val in replacements.items():
                        placeholder = '"'"'{{'"'"' + key + '"'"'}}'"'"'
                        xml_text = xml_text.replace(placeholder, val)
                    if '"'"'{{'"'"' not in xml_text:
                        break
            
            return xml_text
        
        content = merge_and_replace(content)
        
        # Remove layout cache elements (lineSegArray, etc.) from modified paragraphs
        # These cause overlapping characters when text length changes
        # Remove all <hp:lineSegArray>...</hp:lineSegArray> blocks
        content = re.sub(r'"'"'<hp:lineSegArray>.*?</hp:lineSegArray>'"'"', '"'"''"'"', content, flags=re.DOTALL)
        # Also remove <hp:lineSeg .../> self-closing variants
        content = re.sub(r'"'"'<hp:lineSeg[^>]*/>'"'"', '"'"''"'"', content)
        
        # Verify no placeholders remain
        remaining = re.findall(r'"'"'\{\{[^}]*\}\}'"'"', content)
        if remaining:
            print(f"  WARNING: Remaining placeholders: {remaining}")
        else:
            print(f"  All placeholders replaced successfully.")
        
        with open(fpath, '"'"'w'"'"', encoding='"'"'utf-8'"'"') as f:
            f.write(content)

# Repackage as HWPX (ZIP)
# Important: preserve the original ZIP structure and compression
if os.path.exists(OUTPUT_PATH):
    os.remove(OUTPUT_PATH)

# Read original zip to get the entry list and compression info
original_entries = []
with zipfile.ZipFile(TEMPLATE_PATH, '"'"'r'"'"') as zf:
    for info in zf.infolist():
        original_entries.append(info)

with zipfile.ZipFile(OUTPUT_PATH, '"'"'w'"'"', zipfile.ZIP_DEFLATED) as zout:
    for info in original_entries:
        file_path = os.path.join(WORK_DIR, info.filename)
        if os.path.isdir(file_path):
            zout.mkdir(info.filename)
            continue
        if os.path.exists(file_path):
            with open(file_path, '"'"'rb'"'"') as f:
                file_data = f.read()
            # For mimetype, store without compression (OPC convention)
            if info.filename == '"'"'mimetype'"'"':
                zout.writestr(info.filename, file_data, compress_type=zipfile.ZIP_STORED)
            else:
                zout.writestr(info.filename, file_data, compress_type=zipfile.ZIP_DEFLATED)

print(f"\nOutput written to {OUTPUT_PATH}")
print(f"Output size: {os.path.getsize(OUTPUT_PATH)} bytes")

# Final verification: check no {{ remain in output
with zipfile.ZipFile(OUTPUT_PATH, '"'"'r'"'"') as zf:
    for name in zf.namelist():
        if name.endswith('"'"'.xml'"'"'):
            txt = zf.read(name).decode('"'"'utf-8'"'"')
            found = re.findall(r'"'"'\{\{[^}]*\}\}'"'"', txt)
            if found:
                print(f"  FAIL: {name} still contains: {found}")
            else:
                print(f"  OK: {name} - no placeholders")
```

