니다.\" in full_text:\n            appendix_para = p\n            continue\n\n        # Check for window confirmation line\n        if old_window in full_text:\n            window_para = p\n            continue\n\n        # Check for old follow-up patterns\n        if full_text.startswith(\"1. old follow-up\") or \\\n           full_text.startswith(\"2. old follow-up\") or \\\n           full_text.startswith(\"3. old follow-up\"):\n            followup_paras.append((para_id, p))\n\n    # Replace window dates\n    if window_para is not None:\n        para_id = window_para.get('id')\n        replace_text_in_runs(window_para, old_window, new_window)\n        modified_paras.add(para_id)\n        remove_layout_cache(window_para)\n\n    # Sort follow-up paragraphs by ID to maintain order\n    followup_paras.sort(key=lambda x: int(x[0]))\n\n    # Replace follow-up content\n    for i, (para_id, p) in enumerate(followup_paras):\n        if i < len(followups):\n            # Replace with new follow-up item\n            new_text = f\"{followups[i]['sequence']}. {followups[i]['item']}\"\n            set_paragraph_text(p, new_text)\n            modified_paras.add(para_id)\n            remove_layout_cache(p)\n\n    tree.write(xml_path, encoding='UTF-8', xml_declaration=True)\n    return modified_paras\n\n\ndef create_hwpx(source_dir, output_path):\n    \"\"\"Create HWPX ZIP file from source directory.\"\"\"\n    with zipfile.ZipFile(output_path, 'w', zipfile.ZIP_DEFLATED) as zf:\n        for root, dirs, files in os.walk(source_dir):\n            for file in files:\n                file_path = os.path.join(root, file)\n                arcname = os.path.relpath(file_path, source_dir)\n                zf.write(file_path, arcname)\n\n\ndef main():\n    # Paths\n    input_hwpx = '/root/renewal_playbook.hwpx'\n    output_hwpx = '/root/renewal_playbook_updated.hwpx'\n    json_path = '/root/renewal_update.json'\n    csv_path = '/root/followups.csv'\n\n    # Read data\n    update_data = rea