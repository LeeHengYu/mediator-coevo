          "function_name": "Write",
          "arguments": {
            "file_path": "/root/update_hwpx.py",
            "content": "#!/usr/bin/env python3\n\"\"\"\nUpdate HWPX document with data from JSON and CSV files.\n\"\"\"\nimport json\nimport csv\nimport zipfile\nimport os\nimport tempfile\nimport shutil\nfrom xml.etree import ElementTree as ET\n\n# Namespace definitions\nNS_HWPML = \"http://www.hancom.co.kr/hwpml/2010/HWPML\"\nNSMAP = {\"hp\": NS_HWPML}\n\n# Register namespaces to preserve prefixes during serialization\nET.register_namespace(\"hp\", NS_HWPML)\nET.register_namespace(\"opf\", \"http://www.idpf.org/2007/opf\")\n\n\ndef read_update_data(json_path):\n    \"\"\"Read the update data from JSON file.\"\"\"\n    with open(json_path, 'r', encoding='utf-8') as f:\n        return json.load(f)\n\n\ndef read_followups(csv_path):\n    \"\"\"Read follow-up items from CSV file, sorted by sequence.\"\"\"\n    items = []\n    with open(csv_path, 'r', encoding='utf-8') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            items.append({\n                'sequence': int(row['sequence']),\n                'item': row['item']\n            })\n    # Sort by sequence\n    items.sort(key=lambda x: x['sequence'])\n    return items\n\n\ndef extract_hwpx(hwpx_path, dest_dir):\n    \"\"\"Extract HWPX ZIP to destination directory.\"\"\"\n    with zipfile.ZipFile(hwpx_path, 'r') as z:\n        z.extractall(dest_dir)\n    return dest_dir\n\n\ndef get_paragraph_text(p_elem):\n    \"\"\"Get full text content of a paragraph element.\"\"\"\n    texts = []\n    for t in p_elem.iter(f\"{{{NS_HWPML}}}t\"):\n        if t.text:\n            texts.append(t.text)\n    return ''.join(texts)\n\n\ndef set_paragraph_text(p_elem, new_text):\n    \"\"\"Set text content of a paragraph, preserving structure.\"\"\"\n    # Find the first run element\n    for run in p_elem.iter(f\"{{{NS_HWPML}}}run\"):\n        # Find the first text element in the run\n        for t in run.iter(f\"{{{NS_HWPML}}}t\"):\n            t.text = new_text\n            # Remove any other text elements in this run\n            for sibling in list(run):\n                if sibling.tag == f\"{{{NS_HWPML}}}t\" and sibling != t:\n                    run.remove(sibling)\n            break\n        # Clear other runs in the paragraph\n        for sibling in list(p_elem):\n            if sibling.tag == f\"{{{NS_HWPML}}}run\" and sibling != run:\n                p_elem.remove(sibling)\n        break\n\n\ndef remove_layout_cache(p_elem):\n    \"\"\"Remove layout cache elements from a paragraph.\"\"\"\n    for child in list(p_elem):\n        if child.tag == f\"{{{NS_HWPML}}}linesegarray\":\n            p_elem.remove(child)\n\n\ndef replace_text_in_runs(p_elem, old_text, new_text):\n    \"\"\"Replace text in all runs of a paragraph.\"\"\"\n    modified = False\n    full_text = get_paragraph_text(p_elem)\n\n    if old_text in full_text:\n        new_full_text = full_text.replace(old_text, new_text)\n\n        # Try to find and replace in individual text runs\n        for run in p_elem.iter(f\"{{{NS_HWPML}}}run\"):\n            for t in run.iter(f\"{{{NS_HWPML}}}t\"):\n                if t.text and old_text in t.text:\n                    t.text = t.text.replace(old_text, new_text)\n                    modified = True\n\n        # If not replaced in individual runs, try replacing the full text\n        if not modified:\n            set_paragraph_text(p_elem, new_full_text)\n            modified = True\n\n    return modified\n\n\ndef process_section0(xml_path, update_data):\n    \"\"\"Process section0.xml with field replacements.\"\"\"\n    tree = ET.parse(xml_path)\n    root = tree.getroot()\n\n    modified_paras = set()\n\n    # Mapping of old values to new values\n    replacements = {\n        \"Northwind Retail\": update_data['customer'],\n        \"이전담당자\": update_data['owner_name'],\n        \"2025-04-01 ~ 2025-04-15\": f\"{update_data['window_start']} ~ {update_data['window_end']}\",\n        \"Standard-18M\": update_data['band'],\n        \"ops-old@northwind.example\": update_data['escalation_email'],\n        \"기존 메모를 새 메모로 바꾸세요.\": update_data['note'],\n    }\n\n    # Process all paragraphs\n    for p in root.iter(f\"{{{NS_HWPML}}}p\"):\n        para_id = p.get('id')\n        full_text = get_paragraph_text(p)\n\n        for old_val, new_val in replacements.items():\n            if old_val in full_text:\n                if replace_text_in_runs(p, old_val, new_val):\n                    modified_paras.add(para_id)\n                    remove_layout_cache(p)\n\n    # Also handle the case where customer name might be split across runs\n    # Check for \"Northwind\" and \"Retail\" separately\n    for p in root.iter(f\"{{{NS_HWPML}}}p\"):\n        para_id = p.get('id')\n        if para_id in modified_paras:\n            continue\n\n        full_text = get_paragraph_text(p)\n        if \"Northwind\" in full_text and \"Retail\" in full_text:\n            # Replace the full customer name\n            new_customer = update_data['customer']\n            set_paragraph_text(p, f\"고객사: {new_customer}\")\n            modified_paras.add(para_id)\n            remove_layout_cache(p)\n\n    tree.write(xml_path, encoding='UTF-8', xml_declaration=True)\n    return modified_paras\n\n\ndef process_section1(xml_path, update_data, followups):\n    \"\"\"Process section1.xml with follow-up replacements and field updates.\"\"\"\n    tree = ET.parse(xml_path)\n    root = tree.getroot()\n\n    modified_paras = set()\n\n    # Mapping for window date replacement\n    old_window = \"2025-04-01 ~ 2025-04-15\"\n    new_window = f\"{update_data['window_start']} ~ {update_data['window_end']}\"\n\n    # Find follow-up paragraphs and the appendix paragraph\n    followup_paras = []  # (para_id, para_element)\n    appendix_para = None\n    window_para = None\n\n    for p in root.iter(f\"{{{NS_HWPML}}}p\"):\n        para_id = p.get('id')\n        full_text = get_paragraph_text(p)\n\n        # Check for appendix sentence - preserve this\n        if \"이 부록 문단은 그대로 유지해야