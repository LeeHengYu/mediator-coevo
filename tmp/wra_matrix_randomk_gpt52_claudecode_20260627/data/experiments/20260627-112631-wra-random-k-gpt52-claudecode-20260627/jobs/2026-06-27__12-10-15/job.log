## 1 — Write the formulas with openpyxl
```bash
python3 - <<'"'"'PYEOF'"'"'
import openpyxl
import shutil, os

os.makedirs('"'"'/root/output'"'"', exist_ok=True)
shutil.copy2('"'"'/root/data/workbook.xlsx'"'"', '"'"'/root/output/result.xlsx'"'"')

wb = openpyxl.load_workbook('"'"'/root/output/result.xlsx'"'"')
ws = wb['"'"'Task'"'"']

# ---- STEP 1: Populate H12:L17, H19:L24, H26:L31 ----
# Use INDEX(MATCH,MATCH) pattern against Data!$A$21:$<lastcol>$38
# Determine the Data sheet layout from inspection above.
# The formula pattern for cell (r, c) where r is in [12..17, 19..24, 26..31]
# and c is in [8..12] (H..L):
#   =INDEX(Data!<value_range>, MATCH($D<r>, Data!<series_col>, 0), MATCH(<Task>!<col>$10, Data!<year_row>, 0))
# Adjust the exact ranges based on inspection.

# After inspection, fill in the exact ranges. Example (adjust after inspection):
# Suppose Data has series codes in column A rows 21-38, years in row 20 columns B onward,
# and values in B21:<lastcol>38.

# READ the Data sheet layout first
ds = wb['"'"'Data'"'"']
# Find the year header row and series code column from inspection
# ... (use the inspection output to determine these)

# For each block of yellow cells, write INDEX/MATCH formulas.
# The formulas must use absolute references for the Data ranges.

blocks = [(12,17), (19,24), (26,31)]  # row ranges for the three blocks
for (r_start, r_end) in blocks:
    for r in range(r_start, r_end + 1):
        for c_idx, c_letter in enumerate(['"'"'H'"'"','"'"'I'"'"','"'"'J'"'"','"'"'K'"'"','"'"'L'"'"']):
            col_num = 8 + c_idx  # H=8, I=9, ..., L=12
            # Formula: =INDEX(Data!$B$21:$<lastcol>$38, MATCH($D<r>, Data!$A$21:$A$38, 0), MATCH(<c_letter>$10, Data!$B$20:$<lastcol>$20, 0))
            # PLACEHOLDER — replace with actual ranges from inspection
            pass

# ---- STEP 2: Net production slack in H35:L40 ----
# Formula: (Finished_Output - Scrap_And_Rework) / Rated_Production_Capacity * 100
# Finished Output block is rows 12-17, Scrap is rows 19-24, Capacity is rows 26-31
# So H35 = (H12 - H19) / H26 * 100, etc.
for i in range(6):  # 0..5 for the six plants
    for c_letter in ['"'"'H'"'"','"'"'I'"'"','"'"'J'"'"','"'"'K'"'"','"'"'L'"'"']:
        fo_row = 12 + i
        sr_row = 19 + i
        rc_row = 26 + i
        net_row = 35 + i
        col_num = ord(c_letter) - ord('"'"'A'"'"') + 1
        formula = f'"'"'=({c_letter}{fo_row}-{c_letter}{sr_row})/{c_letter}{rc_row}*100'"'"'
        ws.cell(row=net_row, column=col_num, value=formula)

# ---- STEP 2 continued: Summary statistics in H42:L47 ----
# Row 42: MIN, 43: MAX, 44: MEDIAN, 45: MEAN (AVERAGE), 46: 25th percentile, 47: 75th percentile
for c_letter in ['"'"'H'"'"','"'"'I'"'"','"'"'J'"'"','"'"'K'"'"','"'"'L'"'"']:
    col_num = ord(c_letter) - ord('"'"'A'"'"') + 1
    rng = f'"'"'{c_letter}35:{c_letter}40'"'"'
    ws.cell(row=42, column=col_num, value=f'"'"'=MIN({rng})'"'"')
    ws.cell(row=43, column=col_num, value=f'"'"'=MAX({rng})'"'"')
    ws.cell(row=44, column=col_num, value=f'"'"'=MEDIAN({rng})'"'"')
    ws.cell(row=45, column=col_num, value=f'"'"'=AVERAGE({rng})'"'"')
    # Use PERCENTILE.INC with _xlfn. prefix to avoid #NAME? error
    ws.cell(row=46, column=col_num, value=f'"'"'=_xlfn.PERCENTILE.INC({rng},0.25)'"'"')
    ws.cell(row=47, column=col_num, value=f'"'"'=_xlfn.PERCENTILE.INC({rng},0.75)'"'"')

# ---- STEP 3: Weighted mean in H50:L50 ----
# =SUMPRODUCT(H35:H40, H26:H31) / SUM(H26:H31)  — NO, the instruction says use SUMPRODUCT
# Weighted mean = SUMPRODUCT(values, weights) / SUM(weights)
# values = Net production slack (H35:H40), weights = Rated Production Capacity (H26:H31)
for c_letter in ['"'"'H'"'"','"'"'I'"'"','"'"'J'"'"','"'"'K'"'"','"'"'L'"'"']:
    col_num = ord(c_letter) - ord('"'"'A'"'"') + 1
    vals = f'"'"'{c_letter}35:{c_letter}40'"'"'
    wts = f'"'"'{c_letter}26:{c_letter}31'"'"'
    formula = f'"'"'=SUMPRODUCT({vals},{wts})/SUM({wts})'"'"'
    ws.cell(row=50, column=col_num, value=formula)

wb.save('"'"'/root/output/result.xlsx'"'"')
wb.close()
print('"'"'Saved initial version (without Step 1 formulas yet).'"'"')
PYEOF
